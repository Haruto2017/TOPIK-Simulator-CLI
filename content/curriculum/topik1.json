      "level": 2,
      "order": 20,
      "title": "Housing & housework",
      "title_ko": "집안일",
      "scope": "Find a place to live, plan a move, and handle everyday chores.",
      "tasks": ["Compare housing offers", "Plan a move", "Talk about chores", "Use the laundry"],
      "grammar": ["-(으)면 -(으)ㄹ수록", "-는 줄 알다", "처럼", "덕분에", "-(으)면서", "-(으)ㄹ 테니까"],
      "vocab_domains": ["housing", "moving", "chores", "laundry"],
      "dialogues": ["apartment-hunting", "laundry-shop"]
